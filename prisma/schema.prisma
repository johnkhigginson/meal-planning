generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ─── Households & Users ─────────────────────────────────────────

model Household {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  createdAt DateTime @default(now())

  members        User[]
  recipes        Recipe[]
  inventoryItems InventoryItem[]
  mealPlans      MealPlan[]
  groceryLists   GroceryList[]
  stores         Store[]
  invites        HouseholdInvite[]
  recipeBooks    RecipeBook[]
  tags           Tag[]
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique @db.NVarChar(320)
  name             String   @db.NVarChar(200)
  passwordHash     String   @db.NVarChar(200)
  householdId      Int
  role             String   @default("OWNER") @db.NVarChar(20) // OWNER, MEMBER (household role)
  systemRole       String   @default("USER") @db.NVarChar(20) // USER, CONTRIBUTOR, ADMIN
  enabledMealSlots String   @default("BREAKFAST,LUNCH,DINNER,SNACK") @db.NVarChar(200)
  hiddenNavItems   String   @default("") @db.NVarChar(400) // nav hrefs this user hides from their menu
  bio              String?  @db.NVarChar(Max) // public author bio shown on the blog
  avatarUrl        String?  @db.NVarChar(2000) // public author photo
  createdAt        DateTime @default(now())
  lastLogin        DateTime?

  household          Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  authoredRecipes    Recipe[]                 @relation("RecipeAuthor")
  bookCollaborations RecipeBookCollaborator[]
  blogSubscriptions  BlogSubscriber[]
}

model HouseholdInvite {
  id          Int      @id @default(autoincrement())
  householdId Int
  email       String   @db.NVarChar(320)
  invitedBy   Int
  status      String   @default("PENDING") @db.NVarChar(20) // PENDING, ACCEPTED, DECLINED
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, email])
}

// ─── Units & Conversions ────────────────────────────────────────

model Unit {
  id           Int    @id @default(autoincrement())
  name         String @unique @db.NVarChar(50)
  abbreviation String @db.NVarChar(10)
  unitType     String @db.NVarChar(20)

  recipeIngredients        RecipeIngredient[]
  inventoryItems           InventoryItem[]
  groceryListItems         GroceryListItem[]
  storePrices              StorePrice[]
  defaultForIngredients    Ingredient[]
  libraryRecipeIngredients LibraryRecipeIngredient[]

  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
}

model UnitConversion {
  id         Int   @id @default(autoincrement())
  fromUnitId Int
  toUnitId   Int
  factor     Float

  fromUnit Unit @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toUnit   Unit @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fromUnitId, toUnitId])
}

// ─── Ingredients ────────────────────────────────────────────────

model Ingredient {
  id            Int     @id @default(autoincrement())
  name          String  @unique @db.NVarChar(200)
  category      String? @db.NVarChar(100)
  defaultUnitId Int?

  defaultUnit Unit? @relation(fields: [defaultUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  recipeIngredients        RecipeIngredient[]
  inventoryItems           InventoryItem[]
  groceryListItems         GroceryListItem[]
  storePrices              StorePrice[]
  libraryRecipeIngredients LibraryRecipeIngredient[]
}

// ─── Recipes ────────────────────────────────────────────────────

model Recipe {
  id              Int      @id @default(autoincrement())
  householdId     Int
  authorId        Int?     // owner/author of the recipe (a User in the household); null = household default
  name            String   @db.NVarChar(300)
  slug            String?  @db.NVarChar(350) // url-friendly identifier for the public blog
  description     String?  @db.NVarChar(Max)
  instructions    String   @db.NVarChar(Max)
  bodyHtml        String?  @db.NVarChar(Max) // preserved original post HTML (e.g. migrated blog content) — lossless backup
  servings        Int
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  sourceType      String   @default("PERSONAL") @db.NVarChar(20) // PERSONAL, WEBSITE, BOOK, BLOG
  sourceUrl       String?  @db.NVarChar(2000)
  sourceBookTitle String?  @db.NVarChar(300)
  sourceBookPage  String?  @db.NVarChar(50)
  imageUrl        String?  @db.NVarChar(2000)
  isFavorite      Boolean  @default(false)
  publishedAt        DateTime? // original publish date (for migrated blog posts); drives blog ordering
  aiProcessedAt      DateTime? // when the AI ingredient-extraction pass last handled this recipe
  imageLocalizeFailed Boolean  @default(false) // self-hosting this recipe's photo failed; don't retry
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  author          User?              @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ingredients     RecipeIngredient[]
  tags            RecipeTag[]
  mealPlanEntries MealPlanEntry[]
  bookEntries     RecipeBookEntry[]
  shares          ShareLink[]
  notes           RecipeNote[]
  comments        Comment[]

  @@index([householdId, slug])
}

model RecipeIngredient {
  id           Int     @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float
  unitId       Int
  notes        String? @db.NVarChar(200)
  optional     Boolean @default(false)
  sortOrder    Int     @default(0)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RecipeNote {
  id              Int      @id @default(autoincrement())
  recipeId        Int
  body            String   @db.NVarChar(Max)
  createdByUserId Int?
  createdByName   String?  @db.NVarChar(200)
  createdAt       DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

// Audit / activity log of important actions across the app, viewable by admins.
model AuditLog {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  category    String   @db.NVarChar(40) // AUTH, RECIPE, BOOK, COMMENT, IMPORT, USER, ADMIN
  action      String   @db.NVarChar(80) // e.g. LOGIN, RECIPE_CREATED, BOOK_PUBLISHED
  summary     String   @db.NVarChar(500) // human-readable description
  userId      Int? // actor (null for anonymous/system)
  actorName   String?  @db.NVarChar(200) // denormalized so it survives user deletion
  householdId Int?
  targetType  String?  @db.NVarChar(40) // RECIPE, BOOK, USER, COMMENT
  targetId    Int?
  metadata    String?  @db.NVarChar(Max) // optional JSON details
  ip          String?  @db.NVarChar(64)

  @@index([createdAt])
  @@index([category, createdAt])
}

// Recipe photos uploaded from a device. Stored in the DB (rather than the
// filesystem) so they survive rsync-based deploys, and served via /api/images.
model UploadedImage {
  id          Int      @id @default(autoincrement())
  data        Bytes
  contentType String   @db.NVarChar(100)
  uploadedBy  Int?
  createdAt   DateTime @default(now())
}

// Public comments on recipes shown on the published blog. Posted anonymously
// (no login) and gated by Turnstile + honeypot; the recipe owner can delete.
model Comment {
  id         Int      @id @default(autoincrement())
  recipeId   Int
  userId     Int?     // the signed-in commenter; null for imported Blogger comments
  authorName String   @db.NVarChar(120)
  body       String   @db.NVarChar(Max)
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, createdAt])
}

// ─── Tags ───────────────────────────────────────────────────────

model Tag {
  id          Int    @id @default(autoincrement())
  householdId Int?   // null = standard category visible to everyone; otherwise owned by one household
  name        String @db.NVarChar(100)

  // NoAction (not Cascade) so we don't create a second cascade path to RecipeTag
  // alongside Recipe→RecipeTag, which SQL Server rejects. Household deletion is
  // an admin/rare op that removes a household's tags explicitly.
  household Household?  @relation(fields: [householdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipes   RecipeTag[]

  // App-enforced uniqueness on (householdId, name); index supports scoped lookups.
  @@index([householdId, name])
}

model RecipeTag {
  recipeId Int
  tagId    Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
}

// ─── Inventory ──────────────────────────────────────────────────

model InventoryItem {
  id             Int       @id @default(autoincrement())
  householdId    Int
  ingredientId   Int
  quantity       Float
  unitId         Int
  expirationDate DateTime?
  updatedAt      DateTime  @updatedAt

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([householdId, ingredientId])
}

// ─── Meal Planning ──────────────────────────────────────────────

model MealPlan {
  id            Int      @id @default(autoincrement())
  householdId   Int
  weekStartDate DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries      MealPlanEntry[]
  groceryLists GroceryList[]

  @@unique([householdId, weekStartDate])
}

model MealPlanEntry {
  id         Int      @id @default(autoincrement())
  mealPlanId Int
  recipeId   Int
  date       DateTime @db.Date
  mealSlot   String   @db.NVarChar(20)
  servings   Int

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Grocery Lists ──────────────────────────────────────────────

model GroceryList {
  id          Int      @id @default(autoincrement())
  householdId Int
  mealPlanId  Int?
  name        String   @db.NVarChar(200)
  createdAt   DateTime @default(now())

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  mealPlan  MealPlan?         @relation(fields: [mealPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items     GroceryListItem[]
}

model GroceryListItem {
  id            Int     @id @default(autoincrement())
  groceryListId Int
  ingredientId  Int
  quantity      Float
  unitId        Int
  checked       Boolean @default(false)
  inInventory   Float   @default(0)
  needed        Float

  groceryList GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient  Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit        Unit        @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Stores (Stubbed) ──────────────────────────────────────────

model Store {
  id               Int     @id @default(autoincrement())
  householdId      Int
  name             String  @db.NVarChar(200)
  isFavorite       Boolean @default(false)
  krogerLocationId String? @db.NVarChar(50)

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  prices    StorePrice[]
}

model StorePrice {
  id           Int      @id @default(autoincrement())
  storeId      Int
  ingredientId Int
  price        Decimal  @db.Decimal(10, 2)
  quantity     Float
  unitId       Int
  lastUpdated  DateTime @default(now())

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([storeId, ingredientId])
}

// ─── Library (Admin-managed, available to all users) ────────

model LibraryRecipe {
  id              Int      @id @default(autoincrement())
  name            String   @db.NVarChar(300)
  description     String?  @db.NVarChar(Max)
  instructions    String   @db.NVarChar(Max)
  servings        Int
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  sourceType      String   @default("PERSONAL") @db.NVarChar(20)
  sourceUrl       String?  @db.NVarChar(2000)
  category        String?  @db.NVarChar(100)
  createdAt       DateTime @default(now())

  ingredients LibraryRecipeIngredient[]
}

model LibraryRecipeIngredient {
  id              Int     @id @default(autoincrement())
  libraryRecipeId Int
  ingredientId    Int
  quantity        Float
  unitId          Int
  notes           String? @db.NVarChar(200)
  optional        Boolean @default(false)
  sortOrder       Int     @default(0)

  libraryRecipe LibraryRecipe @relation(fields: [libraryRecipeId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model LibraryStore {
  id   Int    @id @default(autoincrement())
  name String @unique @db.NVarChar(200)
}

// ─── Recipe Books ───────────────────────────────────────────────

model RecipeBook {
  id            Int       @id @default(autoincrement())
  householdId   Int
  name          String    @db.NVarChar(300)
  tagline       String?   @db.NVarChar(500) // optional subtitle shown beneath the blog title
  description   String?   @db.NVarChar(Max)
  slug          String?   @db.NVarChar(350) // public blog URL segment; app-enforced unique when published
  coverImageUrl String?   @db.NVarChar(2000)
  isPublished   Boolean   @default(false) // when true, viewable publicly at /blog/[slug] without login
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household     Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  entries       RecipeBookEntry[]
  shares        ShareLink[]
  collaborators RecipeBookCollaborator[]
  subscribers   BlogSubscriber[]
  invites       CookbookInvite[]

  @@index([slug])
}

// A pending invitation to collaborate on a cookbook for someone who doesn't yet
// have an account. They get an email with a tokenized link to sign up and accept.
model CookbookInvite {
  id            Int       @id @default(autoincrement())
  recipeBookId  Int
  email         String    @db.NVarChar(320)
  token         String    @unique @db.NVarChar(100)
  invitedByName String?   @db.NVarChar(200)
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?

  recipeBook RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)

  @@unique([recipeBookId, email])
  @@index([token])
}

// A logged-in visitor following a published cookbook (blog). Followers are
// emailed when a new recipe is posted to the cookbook.
model BlogSubscriber {
  id           Int      @id @default(autoincrement())
  recipeBookId Int
  userId       Int
  createdAt    DateTime @default(now())

  recipeBook RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  // NoAction to avoid a second cascade path to this table via the user/household.
  user       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recipeBookId, userId])
  @@index([recipeBookId])
}

// Lets a user from ANOTHER household help with a cookbook (the blog) without
// joining the owner's household. Collaborators can manage the cookbook and its
// recipes and be credited as recipe authors; their own household stays private.
model RecipeBookCollaborator {
  id           Int      @id @default(autoincrement())
  recipeBookId Int
  userId       Int
  createdAt    DateTime @default(now())

  recipeBook RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recipeBookId, userId])
  @@index([userId])
}

model RecipeBookEntry {
  id           Int      @id @default(autoincrement())
  recipeBookId Int
  recipeId     Int
  sortOrder    Int      @default(0)
  addedAt      DateTime @default(now())

  recipeBook RecipeBook @relation(fields: [recipeBookId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([recipeBookId, recipeId])
}

// ─── Sharing ────────────────────────────────────────────────────

model ShareLink {
  id            Int       @id @default(autoincrement())
  token         String    @unique @db.NVarChar(64)
  shareType     String    @db.NVarChar(20) // RECIPE, BOOK
  recipeId      Int?
  recipeBookId  Int?
  createdById   Int
  createdAt     DateTime  @default(now())
  expiresAt     DateTime? // null = no expiry; set to ~1yr on creation
  revokedAt     DateTime? // set when the owner stops sharing

  recipe     Recipe?     @relation(fields: [recipeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipeBook RecipeBook? @relation(fields: [recipeBookId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

# SQL Server connection string (used by Prisma CLI for migrations/push)
DATABASE_URL="sqlserver://localhost:1433;database=MealPlanning;user=sa;password=YourPassword;trustServerCertificate=true;encrypt=true"

# Individual DB connection params (used by the app via mssql adapter)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=MealPlanning
DB_USER=sa
DB_PASSWORD=YourPassword

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your_secret_here
AUTH_TRUST_HOST=true

# Public site URL — used for absolute links in SEO output (sitemap, RSS, Open
# Graph, JSON-LD). Defaults to https://mylemonkitchen.com when unset.
NEXT_PUBLIC_SITE_URL=https://mylemonkitchen.com

# Public support address shown on the contact, privacy and terms pages. Leave
# empty to hide it; the pages then point to the Help and Contact pages instead.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Analytics (GA4) measurement ID. Defaults to the project's ID when unset.
NEXT_PUBLIC_GA_ID=G-FF20MCHKLB

# Gemini API key (for photo recipe parsing and receipt scanning)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Turnstile (bot protection on the signup form).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both unset to disable Turnstile (honeypot + email normalization still apply).
# Cloudflare test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Google sign-in (optional). Leave unset to hide the "Continue with Google"
# button. OAuth client (Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple sign-in (optional). Leave AUTH_APPLE_ID unset to hide the button.
# AUTH_APPLE_ID is the Services ID. Return URL: https://<your-domain>/api/auth/callback/apple
# (Apple requires HTTPS and a real domain, so it can't be tested on localhost.)
# Then EITHER a ready-made client secret JWT (expires after at most 6 months):
AUTH_APPLE_SECRET=
# OR the key from Apple Developer > Keys, and the app signs a short-lived secret
# itself. The private key is the .p8 file contents; "\n" escapes are fine.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
